# 心旅 AI 环境变量配置
# 复制此文件为 .env 并填入你的 Key

# DeepSeek API Key（用于动态生成诗意文案）
# 获取地址：https://platform.deepseek.com/
# 不填则使用硬编码文案，不影响功能
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 高德地图 Web JS API Key（用于真实地图显示）
# 获取地址：https://lbs.amap.com/
# 不填则降级为 SVG 示意地图
AMAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
