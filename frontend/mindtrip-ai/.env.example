# 心旅 AI 环境变量配置
# 复制此文件为 .env 并填入你的 Key

# DeepSeek API Key（用于动态生成诗意文案）
# 获取地址：https://platform.deepseek.com/
# 不填则使用硬编码文案，不影响功能
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 高德地图 Web JS API Key（用于真实地图显示）
# 获取地址：https://lbs.amap.com/
# 不填则降级为 SVG 示意地图
AMAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 高德 Web 服务 Key（用于天气/POI 查询，如动线页当日天气）
# 高德一个 Key 只能绑定一个平台类型：地图用"Web端(JS API)"，天气/搜索用"Web服务"
# 获取地址：https://console.amap.com/ → 应用管理 → 创建"Web服务"类型 Key
# 不填则天气卡片自动隐藏，不影响其他功能
AMAP_WEB_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
