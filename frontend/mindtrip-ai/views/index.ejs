  <details class="consent-fold reveal">
    <summary>隐私与数据说明 · 进入测评即代表已阅读并同意</summary>
    <div class="consent-fold__body">
      <p>心旅 AI 尊重你的数据主权：你的测评数据与旅行记录仅用于生成本次推荐，不会用于任何商业用途。</p>
      <p>行程结束后所有数据将被清除；打卡与快评数据仅用于优化推荐质量（可选）。</p>
    </div>
  </details>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- 开场：拼图碎片归位拼合 → 揭开首页 ----------
  const mask = document.getElementById('intro-mask');
  const introImg = document.getElementById('intro-img');
  const slogan = document.getElementById('intro-slogan');
  const pieces = Array.from(document.querySelectorAll('.pz'));
  const IMG_URL = '/png/首页的加载页面.jpg';

  function positionPieces() { /* 8 块位置已由 CSS 按 data-i 定义，中心格镂空 */ }
  positionPieces();

  function scatter() {
    const vh = window.innerHeight;
    pieces.forEach(p => {
      const fall = vh * (0.25 + Math.random() * 0.45); // 从屏幕上方下坠
      const rot = (Math.random() * 16 - 8);
      p.style.transform = 'translateY(-' + fall.toFixed(0) + 'px) rotate(' + rot + 'deg)';
      p.style.opacity = 1;
    });
  }

  function assemble() {
    pieces.forEach((p, i) => {
      setTimeout(() => {
        p.style.transition = 'transform 0.72s cubic-bezier(.2,1.35,.4,1), opacity 0.35s ease';
        p.style.transform = 'none';
      }, 240 + i * 120);
    });
    // 拼合完成：slogan 淡出 → 遮罩淡出
    setTimeout(() => {
      if (slogan) { slogan.style.transition = 'opacity 0.4s ease'; slogan.style.opacity = 0; }
    }, 240 + pieces.length * 120 + 400);
    setTimeout(() => {
      mask.style.transition = 'opacity 0.9s ease';
      mask.style.opacity = 0;
      setTimeout(() => { mask.style.display = 'none'; }, 950);
    }, 240 + pieces.length * 120 + 950);
  }

  if (reduceMotion) {
    mask.style.display = 'none';
  } else {
    // 预载拼图底图，加载完成后启动
    const img = new Image();
    img.onload = () => { introImg.style.backgroundImage = "url('" + IMG_URL + "')"; scatter(); assemble(); };
    img.onerror = () => { introImg.style.backgroundImage = "url('" + IMG_URL + "')"; scatter(); assemble(); };
    img.src = IMG_URL;
  }

  // ---------- 滚动：暗 → 光 ----------
  const dawn = document.createElement('div');
  dawn.className = 'dawn';
  document.body.appendChild(dawn);
  let ticking = false;
  function onScroll() {
    const y = window.scrollY;
    const vh = window.innerHeight;
    const t = Math.min(Math.max(y / (vh * 0.85), 0), 1);
    dawn.style.opacity = (t * 0.62).toFixed(3);
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
  }, { passive: true });
  onScroll();

  // ---------- 滚动入场 ----------
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

