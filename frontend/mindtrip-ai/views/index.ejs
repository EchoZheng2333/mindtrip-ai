<%- include('_head') %>

<style>
  /* ========== 首页 Landing v3 · 拼图开场 + 暗到光 ========== */

  /* ---- 开场拼图遮罩 ---- */
  .intro-mask {
    position: fixed; inset: 0; z-index: 60; background: #2A2218;
    display: flex; align-items: center; justify-content: center;
  }
  .intro-mask__img {
    position: absolute; inset: 0; background-size: cover; background-position: center;
    opacity: 0.95;
  }
  .pz {
    position: absolute; width: 33.334%; height: 33.334%;
    background: #3E3528;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35); opacity: 0; will-change: transform;
  }
  .pz[data-i="0"] { left: 0;        top: 0; }
  .pz[data-i="1"] { left: 33.334%;  top: 0;      clip-path: polygon(0 0,100% 0,100% 78%,62% 78%,62% 100%,38% 100%,38% 78%,0 78%); }
  .pz[data-i="2"] { left: 66.668%;  top: 0; }
  .pz[data-i="3"] { left: 0;        top: 33.334%; clip-path: polygon(0 0,100% 0,100% 38%,78% 38%,78% 62%,100% 62%,100% 100%,0 100%); }
  .pz[data-i="5"] { left: 66.668%;  top: 33.334%; clip-path: polygon(100% 0,22% 0,22% 38%,0 38%,0 62%,22% 62%,22% 100%,100% 100%); }
  .pz[data-i="6"] { left: 0;        top: 66.668%; }
  .pz[data-i="7"] { left: 33.334%;  top: 66.668%; clip-path: polygon(0 100%,100% 100%,100% 0,62% 0,62% 22%,38% 22%,38% 0,0 0); }
  .pz[data-i="8"] { left: 66.668%;  top: 66.668%; }
  .intro-slogan {
    position: absolute; z-index: 3; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 33.334%; text-align: center;
    font-family: var(--font-display); font-size: 0.95rem; line-height: 1.9;
    color: #F2E9DA; letter-spacing: 0.05em;
    text-shadow: 0 2px 18px rgba(0,0,0,0.75), 0 0 30px rgba(212,118,62,0.4);
  }
  .intro-slogan b { color: #E8A463; font-weight: 600; }

  /* ---- 暗→光 亮度层 ---- */
  .dawn {
    position: fixed; inset: 0; z-index: 5; pointer-events: none;
    background: linear-gradient(180deg, rgba(250,246,240,0) 0%, rgba(250,246,240,0.92) 100%);
    opacity: 0;
  }

  /* ---- Hero：深棕暗场（对齐 #3E3528 色板） ---- */
  .hero {
    background: linear-gradient(180deg, #2C2419 0%, #3E3528 60%, #46392B 100%);
    color: #EDE3D3; text-align: center;
    margin: -16px -20px 0; padding: 56px 20px 44px;
  }
  .hero-brand {
    font-family: var(--font-display); letter-spacing: 0.34em; font-size: 0.78rem; color: #C9B98F;
  }
  .hero-slogan {
    font-family: var(--font-display); font-size: 1.5rem; font-weight: 600;
    line-height: 1.75; margin-top: 14px; letter-spacing: 0.04em; color: #F2E9DA;
  }
  .hero-slogan b { color: #E8A463; font-weight: 600; }
  .hero-sub { font-size: 0.8rem; color: #C4B998; margin-top: 10px; line-height: 1.8; }
  .hero-cta { display: block; width: 100%; margin-top: 22px; padding: 15px 20px; font-size: 1.02rem; }

  /* ---- 通用区块 ---- */
  .sec { padding: 44px 2px 8px; }
  .sec-title { font-family: var(--font-display); font-size: 1.18rem; font-weight: 600; text-align: center; letter-spacing: 0.04em; }
  .sec-lead { font-size: 0.78rem; text-align: center; margin-top: 6px; margin-bottom: 20px; line-height: 1.8; }

  .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.in { opacity: 1; transform: none; }

  /* ---- 痛点区（暮色） ---- */
  .sec-pain { background: linear-gradient(180deg, #46392B 0%, #57493A 100%); color: #EDE3D3; margin: 0 -20px; padding: 44px 20px 30px; }
  .sec-pain .sec-title { color: #F0E6D5; }
  .sec-pain .sec-lead { color: #B7A98C; }
  .pain-card {
    background: #F7F2EA; border: 1px solid #E4D8C2; border-radius: var(--radius-md);
    padding: 14px 16px; margin-bottom: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.18);
  }
  .pain-card__t { font-weight: 600; color: #3E3528; font-size: 0.94rem; }
  .pain-card__d { font-size: 0.8rem; color: #7A6E5D; margin-top: 4px; line-height: 1.7; }
  .pain-card__fix {
    display: inline-block; margin-top: 8px; font-size: 0.72rem; color: #8B6F47;
    background: #F1E9DA; border: 1px solid #D9C6A6; border-radius: 999px; padding: 3px 10px;
  }

  /* ---- 解法区（晨光） ---- */
  .sec-solve { background: linear-gradient(180deg, #5C4B33 0%, #6B5738 100%); color: #F2E9DA; margin: 0 -20px; padding: 44px 20px 30px; }
  .sec-solve .sec-title { color: #F5EDDE; }
  .sec-solve .sec-lead { color: #C9B98F; }
  .step {
    display: flex; gap: 12px; margin-bottom: 12px;
    background: rgba(250,246,240,0.07); border: 1px solid rgba(250,246,240,0.14);
    border-radius: var(--radius-md); padding: 12px 14px;
  }
  .step__num {
    flex: 0 0 32px; height: 32px; border-radius: 50%;
    background: #E8A463; color: #2A2218; font-family: var(--font-display);
    font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; justify-content: center;
  }
  .step__t { font-size: 0.92rem; font-weight: 600; color: #F5EDDE; }
  .step__d { font-size: 0.78rem; color: #D8CBAE; margin-top: 3px; line-height: 1.7; }

  /* ---- 场景区（白昼） ---- */
  .sec-scene { background: linear-gradient(180deg, #6B5738 0%, #EFE6D6 100%); color: #3E3528; margin: 0 -20px; padding: 44px 20px 30px; }
  .sec-scene .sec-title { color: #3E3528; }
  .sec-scene .sec-lead { color: #7A6E5D; }
  .scene-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .scene-mini {
    background: #FFFDF9; border: 1px solid #E4D8C2; border-radius: var(--radius-md);
    padding: 12px 14px; box-shadow: 0 4px 14px rgba(62,53,40,0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .scene-mini:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(62,53,40,0.14); }
  .scene-mini__name { font-size: 0.9rem; font-weight: 600; color: #3E3528; }
  .scene-mini__desc { font-size: 0.74rem; color: #8A7D6A; margin-top: 3px; line-height: 1.6; }

  /* ---- 收尾 CTA（光） ---- */
  .sec-final { background: #FAF6F0; margin: 0 -20px; padding: 52px 20px 8px; text-align: center; }
  .final-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: #6B4A1F; line-height: 1.8; }
  .final-cta { display: block; width: 100%; margin-top: 22px; padding: 15px 20px; font-size: 1.02rem; }
  .final-note { font-size: 0.7rem; color: #8A7D6A; margin-top: 12px; }

  /* ---- 知情同意折叠区（合规保留，不再单开一屏） ---- */
  .consent-fold {
    max-width: 560px; margin: 18px auto 0; text-align: left;
    background: #FFFDF9; border: 1px solid #E4D8C2; border-radius: 10px;
    padding: 0 14px; font-size: 0.74rem; color: #7A6E5D; line-height: 1.85;
  }
  .consent-fold summary {
    cursor: pointer; padding: 11px 0; color: #6B4A1F; font-weight: 500; list-style: none;
  }
  .consent-fold summary::before { content: '▸ '; }
  .consent-fold[open] summary::before { content: '▾ '; }
  .consent-fold__body { border-top: 1px dashed #E4D8C2; padding: 8px 0 13px; }
  .consent-fold__body p { margin: 6px 0; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .intro-mask { display: none !important; }
  }
</style>

<!-- ========== 开场：记忆拼图（碎片乱序 → 归位拼合 → 揭开首页） ========== -->
<div class="intro-mask" id="intro-mask">
  <div class="intro-mask__img" id="intro-img"></div>
  <div class="intro-slogan" id="intro-slogan">拼凑内心碎片，<br>奔赴<b>适配你的旅途</b></div>
  <div class="pz" data-i="0"></div><div class="pz" data-i="1"></div><div class="pz" data-i="2"></div>
  <div class="pz" data-i="3"></div><div class="pz" data-i="5"></div>
  <div class="pz" data-i="6"></div><div class="pz" data-i="7"></div><div class="pz" data-i="8"></div>
</div>

<!-- ========== Hero：深棕暗场 ========== -->
