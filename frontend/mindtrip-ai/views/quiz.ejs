<%- include('_head') %>

<style>
  /* ===== 测评页：黑金塔罗（深棕底 + 星纹 + 金线） ===== */
  .quiz-bg {
    position: fixed; inset: 0; z-index: 0;
    background: url('/png/用户测试页面.jpg') center/cover no-repeat;
    opacity: 0.88;
  }
  .quiz-mask {
    position: fixed; inset: 0; z-index: 0;
    background: linear-gradient(180deg, rgba(36,29,20,0.42) 0%, rgba(46,37,27,0.62) 100%);
  }
  /* 氛围光晕层：慢速漂移的色温光斑，随选择微变（全视觉沉浸） */
  .quiz-aura {
    position: fixed; inset: -20%; z-index: 1; pointer-events: none;
    background:
      radial-gradient(38% 34% at 22% 26%, hsla(28, 70%, 58%, 0.20), transparent 62%),
      radial-gradient(30% 28% at 78% 30%, hsla(195, 60%, 50%, 0.09), transparent 60%),
      radial-gradient(44% 40% at 52% 82%, hsla(32, 80%, 55%, 0.15), transparent 64%);
    filter: blur(16px);
    animation: auraDrift 18s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes auraDrift {
    0% { transform: translate3d(-1.5%, -1%, 0) scale(1); }
    100% { transform: translate3d(1.5%, 1.2%, 0) scale(1.06); }
  }
  .quiz-aura::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(30% 26% at 50% 42%, hsla(var(--aura-hue, 32), 85%, 62%, 0.20), transparent 66%);
    opacity: 0; transition: opacity 0.9s ease;
  }
  .quiz-aura.hot::after { opacity: 1; }
  #quiz-app { position: relative; z-index: 2; }

  .quiz-header h1 { color: #F2E9DA; text-shadow: 0 2px 12px rgba(0,0,0,0.5); }

  /* 知情同意折叠提示（合规保留，不打断测评流程） */
  .quiz-consent {
    max-width: 560px; margin: 0 auto 14px; text-align: left;
    background: rgba(30,23,15,0.72); border: 1px dashed rgba(196,167,125,0.4);
    border-radius: 10px; padding: 8px 14px; font-size: 0.72rem; color: #C4B998;
  }
  .quiz-consent summary { cursor: pointer; list-style: none; }
  .quiz-consent[open] summary { margin-bottom: 6px; }
  .quiz-consent p { margin: 4px 0; line-height: 1.8; }

  /* 星轨圆环进度 */
  .orbit {
    position: relative; width: 96px; height: 96px; margin: 10px auto 18px;
  }
  .orbit svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .orbit-track { fill: none; stroke: rgba(196,167,125,0.22); stroke-width: 2.5; }
  .orbit-fill {
    fill: none; stroke: #D4763E; stroke-width: 2.5; stroke-linecap: round;
    stroke-dasharray: 276.46; stroke-dashoffset: 276.46;
    filter: drop-shadow(0 0 4px rgba(212,118,62,0.6));
    transition: stroke-dashoffset 0.5s ease;
  }
  .orbit-num {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-size: 0.85rem; color: #F2E9DA; letter-spacing: 0.04em;
  }
  .orbit-deco {
    position: absolute; inset: -14px; border-radius: 50%;
    border: 1px dashed rgba(212,118,62,0.35);
    animation: orbitSpin 22s linear infinite;
  }
  .orbit-deco::before, .orbit-deco::after {
    content: '✦'; position: absolute; color: #E8A463; font-size: 0.6rem; text-shadow: 0 0 6px rgba(232,164,99,0.8);
  }
  .orbit-deco::before { top: -3px; left: 50%; }
  .orbit-deco::after { bottom: 2px; left: 12%; }
  @keyframes orbitSpin { to { transform: rotate(360deg); } }

  /* 题目卡片：深色实底，暖金描边 */
  .quiz-question {
    background: rgba(30,23,15,0.94); border: 1px solid rgba(212,118,62,0.45);
    border-radius: var(--radius-md); padding: 20px 18px; backdrop-filter: blur(4px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.35);
  }
  /* 题干：浅色文字置于深色底上，覆盖全局 style.css 的白底浅字（级联冲突）
     注意：全局 .quiz-scenario 有 background:#fff 与深色文字，这里必须显式覆盖背景 */
  .quiz-scenario {
    color: #FFF7EB;
    font-family: var(--font-display);
    font-size: 1.06rem;
    line-height: 1.95;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(196,167,125,0.2);
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 0;
    box-shadow: none;
    text-shadow: 0 1px 6px rgba(0,0,0,0.6);
  }
  .quiz-section-divider {
    text-align: center; font-size: 0.82rem; font-weight: 600; color: #F0B77D;
    background: rgba(30,23,15,0.92); border: 1px dashed rgba(212,118,62,0.6);
    border-radius: var(--radius-md); padding: 10px 14px; margin-bottom: 16px;
  }
  .quiz-option {
    position: relative; overflow: hidden;
    background: rgba(250,246,240,0.14); border: 1.5px solid rgba(196,167,125,0.55);
    color: #F9F1E4; border-radius: 10px; padding: 13px 15px; text-align: left;
    font-size: 0.92rem; line-height: 1.65; transition: all 0.25s ease; cursor: pointer;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
  .quiz-ripple {
    position: absolute; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(232,164,99,0.45) 0%, transparent 70%);
    transform: scale(0); animation: rippleOut 0.6s ease-out forwards;
  }
  @keyframes rippleOut { to { transform: scale(1); opacity: 0; } }
  .quiz-option:hover { border-color: #D4763E; background: rgba(212,118,62,0.16); }
  .quiz-option--selected {
    border-color: #D4763E; color: #FFF3E2;
    background: rgba(212,118,62,0.22);
    box-shadow: 0 0 14px rgba(212,118,62,0.35);
  }
  .quiz-nav .btn-outline { color: #D8CBAE; border-color: rgba(196,167,125,0.4); background: transparent; }
  .quiz-nav .btn-outline:hover { border-color: #E8A463; color: #F5EDDE; }

  /* 星河人形生成加载过渡层 */
  .gen-mask {
    position: fixed; inset: 0; z-index: 80; background: #241D15;
    display: flex; align-items: center; justify-content: center; flex-direction: column;
  }
  /* 关键修复：display:flex 会覆盖 hidden 属性，必须显式声明 hidden 时隐藏 */
  .gen-mask[hidden] { display: none; }
  .gen-mask__img {
    position: absolute; inset: 0; background: url('/png/做完测试的加载页面.jpg') center/cover no-repeat;
    opacity: 0.85;
  }
  .gen-mask__veil {
    position: absolute; inset: 0; background: linear-gradient(180deg, rgba(30,24,16,0.35), rgba(30,24,16,0.55));
  }
  .gen-particle {
    position: absolute; width: 5px; height: 5px; border-radius: 50%;
    background: #E8A463; box-shadow: 0 0 8px rgba(232,164,99,0.9);
    opacity: 0; transition: transform 1.5s cubic-bezier(.3,.6,.3,1), opacity 0.5s ease;
  }
  .gen-text {
    position: relative; z-index: 2; text-align: center; padding: 0 34px;
    font-family: var(--font-display); font-size: 1rem; line-height: 2; color: #F5EDDE;
    text-shadow: 0 2px 16px rgba(0,0,0,0.7); letter-spacing: 0.05em;
    white-space: pre-line;
  }
  .gen-caret { color: #E8A463; animation: caretBlink 0.85s steps(1) infinite; }
  @keyframes caretBlink { 50% { opacity: 0; } }
</style>

<div class="quiz-bg"></div>
<div class="quiz-mask"></div>
<div class="quiz-aura" id="quiz-aura"></div>

<div class="page-enter" id="quiz-app">
  <div class="quiz-header" style="text-align:center;">
    <h1>心灵测评</h1>
  </div>

  <!-- 知情同意：折叠提示，进入即代表同意 -->
  <details class="quiz-consent">
    <summary>继续测评即代表已阅读并同意《隐私与数据说明》 ▸</summary>
    <p>你的测评数据与旅行记录仅用于生成本次推荐，不会用于任何商业用途；行程结束后所有数据将被清除。</p>
  </details>

  <!-- 星轨圆环进度 -->
  <div class="orbit" id="orbit">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle class="orbit-track" cx="50" cy="50" r="44"/>
      <circle class="orbit-fill" id="orbit-fill" cx="50" cy="50" r="44"/>
    </svg>
    <div class="orbit-deco"></div>
    <div class="orbit-num" id="quiz-counter">1 / 1</div>
  </div>

  <div id="quiz-content"></div>

  <div class="quiz-nav" id="quiz-nav" style="display:none;">
    <button class="btn btn-outline btn-small" id="btn-prev" onclick="prevQuestion()">
      ← 上一题
    </button>
    <span style="flex:1;"></span>
    <button class="btn btn-primary btn-small" id="btn-next" onclick="nextQuestion()">
      下一题 →
    </button>
  </div>
</div>

<!-- 星河人形生成加载过渡层 -->
<div class="gen-mask" id="gen-mask" hidden>
  <div class="gen-mask__img"></div>
  <div class="gen-mask__veil"></div>
  <div id="gen-particles"></div>
  <div class="gen-text"><span id="gen-type"></span><span class="gen-caret">丨</span></div>
</div>

<script>
  const ORBIT_C = 276.46; // 2π×44
  let questions = [];
  let currentIndex = 0;
  let answers = [];
  let autoAdvanceTimer = null; // 首次作答的自动跳题定时器（可被手动前进/回退取消）

  // ---------- 沉浸氛围：Web Audio 合成音 + 色温光晕（全部可降级） ----------
  // 各题的氛围色相：8 道快测在暖金/琥珀/橙之间游走，3 道行程约束转冷青（宁静）
  const AURA_HUES = [32, 27, 36, 30, 42, 24, 46, 20, 190, 200, 208];
  let audioCtx = null;

  function initAudio() {
    try {
      if (audioCtx) return;
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      audioCtx = new AC();
    } catch (e) { /* 无声环境静默降级 */ }
  }

  function playTone(freq, dur = 0.2, type = 'sine', gain = 0.05, when = 0) {
    if (!audioCtx || audioCtx.state !== 'running') return;
    try {
      const t0 = audioCtx.currentTime + when;
      const osc = audioCtx.createOscillator();
      const g = audioCtx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(gain, t0 + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      osc.connect(g);
      g.connect(audioCtx.destination);
      osc.start(t0);
      osc.stop(t0 + dur + 0.05);
    } catch (e) { /* ignore */ }
  }

  // 选择反馈：柔和的"叮"（五声音阶上行，模拟器物轻叩）
  function playSelect() {
    playTone(523.25, 0.2, 'sine', 0.05);
    setTimeout(() => playTone(659.25, 0.18, 'sine', 0.04, 0.06), 0);
  }
  // 进入行程约束段：低音提示
  function playSection() { playTone(392, 0.3, 'triangle', 0.045); }
  // 提交完成：三音上行小和弦
  function playSubmit() {
    playTone(523.25, 0.28, 'sine', 0.05);
    setTimeout(() => playTone(659.25, 0.28, 'sine', 0.045, 0.08), 0);
    setTimeout(() => playTone(783.99, 0.5, 'sine', 0.04, 0.16), 0);
  }

  // 选项涟漪光斑
  function spawnRipple(buttonEl) {
    try {
      const rect = buttonEl.getBoundingClientRect();
      const d = Math.max(rect.width, rect.height) * 1.1;
      const span = document.createElement('span');
      span.className = 'quiz-ripple';
      span.style.width = d + 'px';
      span.style.height = d + 'px';
      span.style.left = (rect.width / 2 - d / 2) + 'px';
      span.style.top = (rect.height / 2 - d / 2) + 'px';
      buttonEl.appendChild(span);
      setTimeout(() => span.remove(), 700);
    } catch (e) { /* ignore */ }
  }

  // 切换当前题的氛围色温
  function setAura(index) {
    const hue = AURA_HUES[index % AURA_HUES.length] || 32;
    document.documentElement.style.setProperty('--aura-hue', hue);
    const aura = document.getElementById('quiz-aura');
    if (aura) {
      aura.classList.remove('hot');
      // 触发重绘后短暂点亮
      void aura.offsetWidth;
      aura.classList.add('hot');
      setTimeout(() => aura.classList.remove('hot'), 900);
    }
  }
</script>

  // 加载题库（8 道快测 + 3 道行程约束）
  async function loadQuiz() {
    const res = await fetch('/api/v1/quiz');
    const data = await res.json();
    questions = [...(data.questions || []), ...(data.constraints || [])];
    answers = new Array(questions.length).fill(null);
    renderQuestion();
  }

  function updateOrbit() {
    const progress = questions.length ? (currentIndex + 1) / questions.length : 0;
    document.getElementById('orbit-fill').style.strokeDashoffset = (ORBIT_C * (1 - progress)).toFixed(1);
    document.getElementById('quiz-counter').textContent = `${currentIndex + 1} / ${questions.length}`;
  }

  function renderQuestion() {
    const q = questions[currentIndex];
    if (!q) return;

    const selectedOption = answers[currentIndex];

    const sectionHeader = q.is_constraint && currentIndex === 8
      ? `<div class="quiz-section-divider">行程安排 · 再答 3 题，推荐会更贴合你的实际安排</div>`
      : '';

    document.getElementById('quiz-content').innerHTML = `
      ${sectionHeader}
      <div class="quiz-question fade-in-up">
        <div class="quiz-scenario">${q.scenario}</div>
        <div class="quiz-options" style="display:flex; flex-direction:column; gap:10px; margin-top:14px;">
          ${q.options.map((opt, i) => `
            <button class="quiz-option ${selectedOption === i ? 'quiz-option--selected' : ''}"
                    onclick="selectOption(${i})">
              ${opt.text}
            </button>
          `).join('')}
        </div>
      </div>
    `;

    updateOrbit();
    setAura(currentIndex);
    if (q.is_constraint && currentIndex === 8) playSection();

    // 导航按钮
    document.getElementById('btn-prev').style.display = currentIndex > 0 ? '' : 'none';
    document.getElementById('quiz-nav').style.display = 'flex';

    const btnNext = document.getElementById('btn-next');
    if (currentIndex === questions.length - 1) {
      btnNext.textContent = '查看结果 →';
      btnNext.disabled = !answers.every(a => a !== null);
      btnNext.style.display = '';
    } else {
      // 中间题也显示"下一题"按钮：用户回退上一题后可以手动前进
      btnNext.textContent = '下一题 →';
      btnNext.disabled = answers[currentIndex] === null;
      btnNext.style.display = '';
    }
  }

  function selectOption(index) {
    initAudio();
    if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
    const wasAnswered = answers[currentIndex] !== null;
    answers[currentIndex] = index;
    playSelect();
    const btns = document.querySelectorAll('.quiz-option');
    if (btns[index]) spawnRipple(btns[index]);
    renderQuestion();

    // 首次作答：选中后自动跳转；回改：不自动跳，让用户自己决定
    if (!wasAnswered) {
      autoAdvanceTimer = setTimeout(() => {
        if (currentIndex < questions.length - 1) {
          currentIndex++;
          renderQuestion();
        } else {
          submitQuiz();
        }
      }, 300);
    }
  }

  async function nextQuestion() {
    clearTimeout(autoAdvanceTimer); // 手动前进时取消自动跳转，避免连跳
    if (currentIndex < questions.length - 1) {
      currentIndex++;
      renderQuestion();
    } else {
      await submitQuiz();
    }
  }

  // ---------- 星河人形加载过渡 ----------
  // 打字机：一个字一个字弹出
  function typeWriter() {
    const el = document.getElementById('gen-type');
    const LINES = ['正在收集你的审美碎片', '勾勒专属心灵轮廓'];
    let li = 0, ci = 0;
    function tick() {
      if (li >= LINES.length) return;
      if (ci < LINES[li].length) {
        el.textContent += LINES[li][ci];
        ci++;
        setTimeout(tick, 85);
      } else {
        el.textContent += '\n';
        li++; ci = 0;
        setTimeout(tick, 240);
      }
    }
    tick();
  }

  function showGenLoading() {
    const mask = document.getElementById('gen-mask');
    mask.hidden = false;

    const container = document.getElementById('gen-particles');
    const vw = window.innerWidth, vh = window.innerHeight;
    const cx = vw / 2, cy = vh / 2;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce) {
      document.getElementById('gen-type').textContent = '正在收集你的审美碎片\n勾勒专属心灵轮廓';
      setTimeout(() => { window.location.href = '/profile'; }, 600);
      return;
    }

    // 星光粒子从四周向中心汇聚（勾勒人形轮廓的方向感）
    const N = 26;
    for (let i = 0; i < N; i++) {
      const dot = document.createElement('span');
      dot.className = 'gen-particle';
      const angle = (i / N) * Math.PI * 2;
      const dist = Math.max(vw, vh) * (0.55 + Math.random() * 0.35);
      const sx = cx + Math.cos(angle) * dist;
      const sy = cy + Math.sin(angle) * dist * 1.4;
      const tx = cx + (Math.random() - 0.5) * 120;
      const ty = cy + (Math.random() - 0.5) * 160;
      dot.style.left = sx + 'px';
      dot.style.top = sy + 'px';
      container.appendChild(dot);
      requestAnimationFrame(() => {
        setTimeout(() => {
          dot.style.transform = `translate(${tx - sx}px, ${ty - sy}px)`;
          dot.style.opacity = '0.9';
        }, i * 45);
      });
    }

    typeWriter();
    setTimeout(() => { window.location.href = '/profile'; }, 2250);
  }

  async function submitQuiz() {
    if (!answers.every(a => a !== null)) return;
    playSubmit();

    const answerData = answers.map((optIdx, i) => ({
      question_id: questions[i].id,
      option_index: optIdx
    }));

    const res = await fetch('/api/v1/submit_quiz', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ answers: answerData })
    });

    const data = await res.json();
    if (data.success) {
      showGenLoading();
    } else {
      alert(data.message || '提交失败，请重试');
    }
  }

  function prevQuestion() {
    clearTimeout(autoAdvanceTimer); // 回退时取消自动跳转，避免随后被带到下一题
    if (currentIndex > 0) {
      currentIndex--;
      renderQuestion();
    }
  }

  loadQuiz();
</script>

<%- include('_foot') %>
